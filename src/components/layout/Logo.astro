---
import { siteConfig } from "../../config/site.config";
export interface Props {
  href?: string;
}

const { href = "/" } = Astro.props as Props;
---

<a href={href} class="logo" aria-label={siteConfig.name}>
  <img
    class="logo__mark logo__mark--light"
    src={siteConfig.branding.logo.light}
    alt={`${siteConfig.name} logo`}
    width="40"
    height="40"
  />
  <img
    class="logo__mark logo__mark--dark"
    src={siteConfig.branding.logo.dark}
    alt=""
    aria-hidden="true"
    width="40"
    height="40"
  />
  <span class="logo__name">{siteConfig.name}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-text-primary);
    border-radius: var(--radius-md);
  }

  .logo:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .logo__mark {
    display: block;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
  }

  .logo__mark--dark {
    display: none;
  }

  :global(.dark) .logo__mark--light {
    display: none;
  }

  :global(.dark) .logo__mark--dark {
    display: block;
  }

  .logo__name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  /* Keep the brand compact on small screens — monogram remains. */
  @media (max-width: 26rem) {
    .logo__name {
      display: none;
    }
  }
</style>
